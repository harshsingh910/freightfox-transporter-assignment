# ==============================================================================
# FreightFox Transporter Assignment Platform - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
# Railway automatically supplies DATABASE_URL or individual PG* variables:
DATABASE_URL=postgresql://postgres:password@localhost:5432/freightfox
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=freightfox
# PGUSER=postgres
# PGPASSWORD=password
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5

# Redis Configuration (Distributed Rate Limiting and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Configuration
# Provide a cryptographically secure 256-bit+ HMAC secret key in production (e.g. generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_hex_key_at_least_32_bytes
JWT_ISSUER=freightfox-platform
JWT_ACCESS_TOKEN_TTL=86400

# Initial Bootstrap Administrator (Created on first run if enabled)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@freightfox.com
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!

# Distributed Rate Limiting (Token Bucket Quotas)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FALLBACK_IN_MEMORY=false
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_ASSIGNMENT=20
RATE_LIMIT_IMPORT=5
RATE_LIMIT_GENERAL=120

# Optimization Engine Limits
MAX_OPTIMIZATION_LANES=100
MAX_OPTIMIZATION_TRANSPORTERS=50
MAX_OPTIMIZATION_RUNTIME=30
OPTIMIZER_OBJECTIVE=LEXICOGRAPHIC_MAX_TRANSPORTERS_MIN_COST

# CORS Origins (Comma-separated origins or *)
CORS_ALLOWED_ORIGINS=*
